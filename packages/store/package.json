  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "pino": "^9.6.0",
    "pinyin-pro": "^3.29.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3"
  }
}
