{
  "name": "@kairo/driver",
  "version": "2.0.0",
  "description": "Pure, event-driven CDP driver for KK9 desktop client",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../..",
    "test:watch": "vitest --root ../..",
    "dev": "tsx watch src/index.ts",
    "verify": "tsx examples/verify.ts",
    "diagnose": "tsx examples/diagnose.ts",
    "e2e": "tsx examples/e2e-real-test.ts"
  },
  "dependencies": {
    "mime-types": "^3.0.2",
    "pino": "^9.6.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.12.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
