{
  "name": "@kkbot/gateway",
  "version": "2.0.0",
  "description": "Session coordinator and state machine gateway for KKBot",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kkbot/agent": "workspace:*",
    "@kkbot/driver": "workspace:*",
    "@kkbot/store": "workspace:*",
    "@libsql/client": "^0.17.4",
    "@mastra/core": "1.61.0",
    "@mastra/libsql": "1.21.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "zod": "4.4.3"
  }
}
